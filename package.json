{
  "name": "fig-tree",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Fig Tree: an open-source collaborative interface design tool.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "typecheck": "tsc -p packages/geometry && tsc -p packages/renderer && tsc -p packages/document && tsc -p e2e && npm run typecheck -w @fig-tree/editor",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build -w @fig-tree/editor",
    "test:e2e": "playwright test",
    "test:render": "playwright test --project=render",
    "bench": "playwright test --project=bench"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "ajv": "8.20.0",
    "fast-check": "4.10.2",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
